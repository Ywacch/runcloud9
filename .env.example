# Cloud9 API runtime configuration example
# Copy to .env locally and fill real values. Never commit secrets.

# Required
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key

# Required in current production auth mode
SUPABASE_JWT_SECRET=replace-with-jwt-secret

# Runtime mode and deployer
ENV=development
DEPLOYER=local

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Metrics and diagnostics
PROMETHEUS_URL=http://localhost:9090
DDC_BUCKET=
SENTRY_DSN=

# Seeding
SEED_BUCKET_NAME=cloud9-seed-data

# Image resolution
TEMPLATE_IMAGE_REGISTRY=
TEMPLATE_IMAGE_TAG=v1
IMAGE_VERSIONS_FILE=config/image-versions.json

# Limits
MAX_ACTIVE_DEPLOYMENTS_PER_USER=1

# Optional kubeconfig path when DEPLOYER=k8s
# KUBECONFIG=/path/to/kubeconfig

